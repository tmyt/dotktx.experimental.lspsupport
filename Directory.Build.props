<Project>
  <PropertyGroup>
    <!-- LspSupport has its own release sequence, independent of the compiler below. -->
    <VersionPrefix>0.9.6</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <!-- The analysis JAR metadata must match this DotKt/Kotlin release pair. -->
    <DotKtVersion>0.9.23</DotKtVersion>
    <DotKtKotlinVersion>2.4.21</DotKtKotlinVersion>
    <TargetFramework>net10.0</TargetFramework>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages/</PackageOutputPath>
    <IsPackable Condition="'$(MSBuildProjectExtension)' == '.ktproj'">false</IsPackable>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
