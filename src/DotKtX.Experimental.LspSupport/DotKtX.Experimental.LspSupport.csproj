<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>DotKtX.Experimental.LspSupport</AssemblyName>
    <RootNamespace>DotKtX.Experimental.LspSupport</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>DotKtX.Experimental.LspSupport</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NuspecFile>packaging/DotKtX.Experimental.LspSupport.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)/packaging</NuspecBasePath>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- .NET SDK 11 also reads nuspec tokens while calculating package output paths. -->
  <Target Name="SetLspNuspecProperties" BeforeTargets="_GetOutputItemsFromPack;GenerateNuspec">
    <PropertyGroup>
      <NuspecProperties>version=$(PackageVersion);toolOutput=$(TargetDir);dotKtVersion=$(DotKtVersion);versionFile=$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'dotkt-version.txt'))</NuspecProperties>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)dotkt-version.txt" Lines="$(DotKtVersion)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
