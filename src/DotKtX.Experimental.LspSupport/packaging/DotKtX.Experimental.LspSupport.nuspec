<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>DotKtX.Experimental.LspSupport</id>
    <version>$version$</version>
    <authors>DotKtX</authors>
    <license type="expression">Apache-2.0</license>
    <readme>README.md</readme>
    <projectUrl>https://github.com/tmyt/dotktx.experimental.lspsupport</projectUrl>
    <repository type="git" url="https://github.com/tmyt/dotktx.experimental.lspsupport.git" />
    <description>Experimental JetBrains Kotlin LSP workspace generation for DotKt projects. Registers the CLR reference KLIBs and the DotKt standard library directly with Kotlin LSP 271.2085.0 and later. Targets DotKt $dotKtVersion$.</description>
    <tags>dotkt kotlin clr lsp vscode experimental</tags>
  </metadata>
  <files>
    <file src="../../../README.md" target="README.md" />
    <file src="../../../LICENSE.txt" target="LICENSE.txt" />
    <file src="../../../NOTICE.txt" target="NOTICE.txt" />
    <file src="$versionFile$" target="build/dotkt-version.txt" />
    <file src="build/**" target="build" />
    <file src="$toolOutput$DotKtX.Experimental.LspSupport.dll" target="tools/net10.0/any" />
    <file src="$toolOutput$DotKtX.Experimental.LspSupport.deps.json" target="tools/net10.0/any" />
    <file src="$toolOutput$DotKtX.Experimental.LspSupport.runtimeconfig.json" target="tools/net10.0/any" />
  </files>
</package>
