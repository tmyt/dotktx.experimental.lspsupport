<Project Sdk="DotKt.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <StartupObject>ProgramKt</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ReceiverFixture/ReceiverFixture.ktproj" />
    <PackageReference Include="DotKtX.Experimental.LspSupport"
                      Version="$(Version)"
                      PrivateAssets="all"
                      IncludeAssets="build" />
  </ItemGroup>
</Project>
